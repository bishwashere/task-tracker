generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  guidedMode    Boolean   @default(true)

  organizations    UserOrganization[]
  assignedSubtasks Subtask[]          @relation("AssignedSubtasks")
  Comment          Comment[]
  points           PointsEarned[]
  subscription     Subscription[]
}

model Organization {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  type      String?
  field     String?
  need      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  projects  Project[]
  members   UserOrganization[]
}

model UserOrganization {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String           @db.ObjectId
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String           @db.ObjectId
  role           OrganizationRole // "ADMIN" or "MEMBER"
  createdAt      DateTime         @default(now())
  updatedAt      DateTime?        @updatedAt

  @@unique([userId, organizationId]) // Ensure a user is in an org only once
}

enum OrganizationRole {
  ADMIN
  MEMBER
}

model PointsEarned {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtaskId        String   @db.ObjectId
  subtaskName      String
  organizationId   String   @db.ObjectId
  organizationName String
  projectId        String   @db.ObjectId
  projectName      String
  taskId           String   @db.ObjectId
  taskName         String
  points           Float    @default(0)
  createdAt        DateTime @default(now())

  @@unique([userId, subtaskId])
}

model Project {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String             @unique
  description       String?
  goal              String?
  focusArea         String?
  mainGoal          String?
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId    String             @db.ObjectId
  hasAiSuggestTasks Boolean            @default(false)
  tasks             Task[]
  AISuggestedTask   AISuggestedTask[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  projectSortIndex  ProjectSortIndex[]
  insight           Insight[]
  projectSummary    ProjectSummary[]
  sprints           Sprint[]
}

model ProjectSortIndex {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  projectId String  @db.ObjectId
  sortIndex Int
  userId    String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id])
}

model Task {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  description      String?
  project          Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId        String          @db.ObjectId
  subtasks         Subtask[]
  hasAISuggestions Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  taskSortIndex    TaskSortIndex[]
}

model TaskSortIndex {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  taskId    String @db.ObjectId
  sortIndex Int
  userId    String @db.ObjectId
  task      Task   @relation(fields: [taskId], references: [id])
}

model Subtask {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  taskId           String             @db.ObjectId
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedUser     User?              @relation("AssignedSubtasks", fields: [assignedUserId], references: [id])
  assignedUserId   String?            @db.ObjectId
  dueDate          DateTime?
  points           Float              @default(10)
  status           String             @default("pending")
  priority         Int                @default(0)
  tagName          String?
  tagColor         String?
  comments         Comment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subtaskSortIndex SubtaskSortIndex[]
  completedAt      DateTime?
}

model SubtaskSortIndex {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  subtaskId String  @db.ObjectId
  sortIndex Int
  userId    String  @db.ObjectId
  subtask   Subtask @relation(fields: [subtaskId], references: [id])
}

model Comment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  subtask     Subtask  @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  subtaskId   String   @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @db.ObjectId
  comment     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  commentType String   @default("comment")
  resolved    Boolean  @default(false)
}

model AISuggestedTask {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  projectId   String   @db.ObjectId
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Subscription {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  userId             String    @unique @db.ObjectId
  user               User      @relation(fields: [userId], references: [id])
  stripeCustomerId   String?
  planId             String?
  status             String    @default("trial")
  subscriptionId     String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Insight {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  projectId          String    @unique @db.ObjectId
  project            Project   @relation(fields: [projectId], references: [id])
  insights           String[]
  desiredOutcome     String[]
  updatedAt          DateTime  @updatedAt
}

model ProjectSummary {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  projectId String   @unique @db.ObjectId
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prompt    String?
  response  String?
  done      String[]
  pending   String[]
}

enum SprintStatus {
  ACTIVE
  COMPLETED
}

enum SprintType {
  GROWTH
  RELIABILITY
  LAUNCH
  ONBOARDING
  SEO
  ANALYTICS
  INFRASTRUCTURE
  EXPERIMENT
  RETENTION
  AI_QUALITY
}

model Sprint {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId     String       @db.ObjectId
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  sprintType    SprintType   @default(LAUNCH)
  weekNumber    Int
  durationDays  Int          @default(7)
  primaryGoal   String?
  targetMetric  String?
  taskIds       String[]     @db.ObjectId
  startDate     DateTime     @default(now())
  endDate       DateTime
  status        SprintStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}
